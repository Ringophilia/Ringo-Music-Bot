[Unit]
Description=ringo-music TeamSpeak music bot
After=network-online.target teamspeak3.service
Wants=network-online.target

[Service]
Type=simple
User=ringomusic
Group=ringomusic
WorkingDirectory=/opt/ringo-music
Environment=HOME=/opt/ringo-music
ExecStart=/opt/ringo-music/ringo-music -c /opt/ringo-music/config.toml run
Restart=always
RestartSec=5
# Bot + ffmpeg usually stay under 40 MB.
MemoryMax=256M
TasksMax=64
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ringo-music
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
